# Test environment configuration for sandbox testing
# Using SQLite in-memory database to avoid MySQL dependency

APP_NAME=FDE Workbench API (Test)
APP_ENV=testing
APP_DEBUG=true
APP_PORT=8080

# SQLite in-memory database
DATABASE_URL=sqlite:///./test.db

# Disable external services by using memory/localhost fallbacks
REDIS_URL=memory://
ES_HOST=
MILVUS_HOST=

# AI Orchestrator (disable for independent API testing)
AI_ORCHESTRATOR_URL=
AI_ORCHESTRATOR_TIMEOUT=5

# Auth - fixed secret for testing
JWT_SECRET_KEY=test-secret-key-for-sandbox-testing-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Celery - use memory broker
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=memory://

# External Integrations - disabled for testing
AONE_API_URL=
CRM_API_URL=
OSS_ENDPOINT=

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text
