# Environment Variables Template
# Copy this to .env for local development

# Application
APP_NAME=FDE Workbench API
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# Database
DATABASE_URL=mysql://root:password@localhost:3306/fde_workbench?charset=utf8mb4

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ES_HOST=http://localhost:9200

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# AI Orchestrator
AI_ORCHESTRATOR_URL=http://localhost:8090

# Auth
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# External Integrations
AONE_API_URL=
AONE_API_TOKEN=
CRM_API_URL=
CRM_API_TOKEN=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json