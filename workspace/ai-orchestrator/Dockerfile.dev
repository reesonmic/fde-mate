# AI Orchestrator - Development Dockerfile
# Optimized for fast iteration with hot reload support

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Install Poetry
ENV POETRY_HOME=/opt/poetry \
    POETRY_VERSION=1.8.2 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1 \
    POETRY_CACHE_DIR=/opt/poetry-cache

RUN pip install --no-cache-dir poetry==$POETRY_VERSION && \
    mkdir -p $POETRY_CACHE_DIR

ENV PATH="$POETRY_HOME/bin:$PATH"

# Copy dependency files first (caching optimization)
COPY pyproject.toml poetry.lock* ./

# Configure poetry
RUN poetry config virtualenvs.create true && \
    poetry config virtualenvs.in-project true

# Install dependencies (cached if pyproject.toml unchanged)
RUN poetry install --no-interaction --no-root --no-ansi

# Copy application code
COPY app ./app

# Install project
RUN poetry install --no-interaction --no-ansi

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8090/health || exit 1

# Default command
CMD ["poetry", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8090", "--reload"]
