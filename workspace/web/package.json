{
  "name": "fde-workbench-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:real": "VITE_USE_MOCK=false vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "gen:types": "openapi-typescript ../shared-protos/openapi/api.json -o src/types/api.d.ts",
    "prepare": "cd .. && husky install web/.husky"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "ant-design-vue": "^4.1.2",
    "@ant-design/icons-vue": "^7.0.1",
    "axios": "^1.6.8",
    "dayjs": "^1.11.10",
    "dompurify": "^3.0.9",
    "lodash-es": "^4.17.21",
    "marked": "^12.0.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.12.7",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "typescript": "~5.4.5",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.13",
    "vitest": "^1.5.0",
    "@vitest/coverage-v8": "^1.5.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint-plugin-vue": "^9.25.0",
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "openapi-typescript": "^6.7.5",
    "msw": "^2.2.14",
    "jsdom": "^24.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/eslint-config-prettier": "^9.0.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}