# Environment Variables Template
# Copy this to .env.local for local development

# API Base URL (backend service)
VITE_API_BASE_URL=http://localhost:8080

# Use MSW mock server (true/false)
VITE_USE_MOCK=true

# AI Orchestrator URL (internal, goes through API proxy)
VITE_AI_URL=http://localhost:8090

# Application title
VITE_APP_TITLE=FDE Workbench

# Enable debug mode
VITE_DEBUG=true